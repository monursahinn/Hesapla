<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Hesapla</RootNamespace>
    <UserSecretsId>hesapla-api-5b2e9c41-7d3a-4f6e-a1c8-0e9d2b7f4a63</UserSecretsId>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SpaRoot>ClientApp\</SpaRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
  </ItemGroup>

  <!-- Uygulama açılışta tabloları bu betikten (yoksa) oluşturur; aynı betik db/ klasöründe elle de çalıştırılabilir. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\db\schema.sql" LogicalName="Hesapla.schema.sql" />
  </ItemGroup>

  <!-- ClientApp kaynakları derlemeye dahil edilmez; yayında Vite ile wwwroot/app altına derlenir. -->
  <ItemGroup>
    <Compile Remove="ClientApp\**" />
    <Content Remove="ClientApp\**" />
    <None Remove="ClientApp\**" />
  </ItemGroup>

  <Target Name="PublishClientApp" BeforeTargets="ComputeFilesToPublish" Condition="Exists('$(SpaRoot)package.json')">
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm ci" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build" />
    <ItemGroup>
      <DistFiles Include="wwwroot\app\**" />
      <ResolvedFileToPublish Include="@(DistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>%(DistFiles.Identity)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
