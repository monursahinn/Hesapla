<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage
    x:Class="Hesapla.Mobile.Views.Pages.CashPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Hesapla.Mobile.Views"
    xmlns:vm="clr-namespace:Hesapla.Mobile.ViewModels"
    xmlns:controls="clr-namespace:Hesapla.Mobile.Controls"
    xmlns:api="clr-namespace:Hesapla.Mobile.Models.Api"
    x:DataType="vm:CashViewModel"
    Title="Kasa ve Banka">

    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}">
        <CollectionView ItemsSource="{Binding Items}" SelectionMode="None" Margin="16,0"
                        RemainingItemsThreshold="5" RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
            <CollectionView.Header>
                <VerticalStackLayout Spacing="10" Padding="0,16,0,8">
                    <CollectionView ItemsSource="{Binding Accounts}" ItemsLayout="HorizontalList" HeightRequest="84" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="api:Account">
                                <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,10,0" WidthRequest="170">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Name}" Style="{StaticResource MutedLabel}" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Balance, Converter={StaticResource Currency}}" FontFamily="OpenSansSemibold" FontSize="16" />
                                        <Label Text="{Binding TypeText}" Style="{StaticResource MutedLabel}" FontSize="11" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Border Style="{StaticResource InputBorder}">
                            <Picker ItemsSource="{x:Static vm:CashViewModel.Types}" SelectedIndex="{Binding SelectedTypeIndex}" ItemDisplayBinding="{Binding Text, x:DataType=api:Option}" />
                        </Border>
                        <Button Grid.Column="1" Text="+ Yeni kayıt" Style="{StaticResource PrimaryButton}" HeightRequest="44" Padding="16,0"
                                Command="{Binding NewCommand}" IsVisible="{Binding CanWrite}" />
                    </Grid>
                    <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}" IsVisible="{Binding HasError}" />
                    <controls:Skeleton Rows="5" IsVisible="{Binding ShowSkeleton}" />
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.EmptyView>
                <Label Text="Kayıt yok." Style="{StaticResource SubtitleLabel}" HorizontalOptions="Center" Margin="0,40" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="api:Movement">
                    <Border Style="{StaticResource ListCard}">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10">
                            <Label Text="{Binding Title}" Style="{StaticResource CardTitleLabel}" />
                            <Label Grid.Column="1" Text="{Binding SignedAmount}" FontFamily="OpenSansSemibold" HorizontalOptions="End" />
                            <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Subtitle}" Style="{StaticResource MutedLabel}" />
                            <Label Grid.Row="2" Text="{Binding DateLine}" Style="{StaticResource MutedLabel}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
</views:BasePage>
