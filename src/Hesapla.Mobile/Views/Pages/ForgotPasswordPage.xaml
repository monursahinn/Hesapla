<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage
    x:Class="Hesapla.Mobile.Views.Pages.ForgotPasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Hesapla.Mobile.Views"
    xmlns:vm="clr-namespace:Hesapla.Mobile.ViewModels"
    x:DataType="vm:ForgotPasswordViewModel"
    Shell.FlyoutBehavior="Disabled"
    Title="Şifremi unuttum">

    <ScrollView>
        <VerticalStackLayout Padding="20,24" Spacing="16">
            <Label Text="Hesabınızın e-posta adresini girin. Şifre sıfırlama bağlantısı gönderilecektir; bağlantı 30 dakika geçerlidir ve web panelinde açılır."
                   Style="{StaticResource SubtitleLabel}" />

            <VerticalStackLayout Spacing="8">
                <Label Text="E-posta" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource InputBorder}">
                    <Entry Text="{Binding Email}" Placeholder="ornek@firma.com" Keyboard="Email" IsSpellCheckEnabled="False"
                           IsTextPredictionEnabled="False" ReturnType="Send" ReturnCommand="{Binding SendCommand}" />
                </Border>
            </VerticalStackLayout>

            <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}" IsVisible="{Binding HasError}" />

            <Border Style="{StaticResource Card}" BackgroundColor="{DynamicResource SuccessBgColor}" Stroke="{DynamicResource SuccessBorderColor}"
                    IsVisible="{Binding SuccessMessage, Converter={StaticResource HasText}}">
                <Label Text="{Binding SuccessMessage}" TextColor="{DynamicResource SuccessTextColor}" FontSize="14" />
            </Border>

            <Button Text="Bağlantı gönder" Style="{StaticResource PrimaryButton}" Command="{Binding SendCommand}" IsEnabled="{Binding IsNotBusy}" />
        </VerticalStackLayout>
    </ScrollView>
</views:BasePage>
