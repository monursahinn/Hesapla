<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!--
			iOS yalnızca Windows/macOS'ta derlenebilir; Linux CI'da (Android işi) iOS hedefi eklenmez.
			iOS SDK sürümü sabittir: her SDK tam olarak eşleşen Xcode major.minor sürümünü ister
			(ios26.0 => Xcode 26.0.x). GitHub runner'larında Xcode 27 yayınlandığında net10.0-ios27.0
			yapılıp .github/workflows/build.yml içindeki IOS_TFM / XCODE_VERSION güncellenmelidir.
		-->
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios26.0</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>Hesapla.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- XAML derleme zamanı bağlama (performans + derleme hatası olarak binding kontrolü) -->
		<MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>

		<ApplicationTitle>Hesapla</ApplicationTitle>
		<ApplicationId>com.hesapla.mobile</ApplicationId>
		<ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!--
			Mobil uygulamanın bağlandığı sunucu. Release için varsayılan canlı adres; derlemede değiştirilebilir:
			  dotnet publish -p:HesaplaApiBaseUrl=https://test.alanadiniz.com/
		-->
		<HesaplaApiBaseUrl Condition="'$(HesaplaApiBaseUrl)' == ''">https://hesapla.example.com/</HesaplaApiBaseUrl>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>HesaplaApiBaseUrl</_Parameter1>
			<_Parameter2>$(HesaplaApiBaseUrl)</_Parameter2>
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" ForegroundScale="0.62" Color="#4F46E5" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#4F46E5" BaseSize="180,180" />
		<MauiImage Include="Resources\Images\*" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
		<PackageReference Include="CommunityToolkit.Maui" Version="15.0.1" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
	</ItemGroup>

</Project>
