<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    x:Class="Hesap.Mobile.Resources.Styles.Colors"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Varsayılan (Koyu) tema. Diğer temalar Services/ThemeService.cs ile bu anahtarların üzerine yazılır;
         sayfalarda renkler DynamicResource ile kullanılmalıdır. -->

    <!-- PAGE -->
    <Color x:Key="PageBackgroundColor">#050B16</Color>
    <Color x:Key="SeparatorColor">#1F2937</Color>
    <Color x:Key="HeaderBackgroundColor">#0A1220</Color>

    <!-- CARD -->
    <Color x:Key="CardBackgroundColor">#151A24</Color>
    <Color x:Key="CardBorderColor">#2B3445</Color>
    <Color x:Key="CardAltBackgroundColor">#101826</Color>

    <!-- TEXT -->
    <Color x:Key="PrimaryTextColor">#FFFFFF</Color>
    <Color x:Key="SecondaryTextColor">#A1A1AA</Color>
    <Color x:Key="MutedTextColor">#9CA3AF</Color>

    <!-- INPUT -->
    <Color x:Key="InputBackgroundColor">#0B1220</Color>
    <Color x:Key="InputTextColor">#F8FAFC</Color>
    <Color x:Key="InputPlaceholderColor">#6B7280</Color>
    <Color x:Key="InputBorderColor">#2F3B50</Color>
    <Color x:Key="InputFocusedBorderColor">#475569</Color>

    <!-- ACCENT -->
    <Color x:Key="AccentTeal">#2DD4BF</Color>
    <Color x:Key="AccentBlue">#3B82F6</Color>
    <Color x:Key="AccentCyan">#22D3EE</Color>
    <Color x:Key="AccentSky">#6366F1</Color>
    <!-- Vurgu rengi / gradyan üzerindeki metin -->
    <Color x:Key="OnAccentColor">#04131A</Color>
    <Color x:Key="ChatBubbleMineColor">#0F3B3A</Color>

    <!-- STATUS -->
    <Color x:Key="SuccessBgColor">#0D2A1F</Color>
    <Color x:Key="SuccessBorderColor">#22C55E</Color>
    <Color x:Key="SuccessTextColor">#4ADE80</Color>
    <Color x:Key="WarningTextColor">#FBBF24</Color>
    <Color x:Key="WarningBgColor">#2A2110</Color>
    <Color x:Key="ErrorTextColor">#F87171</Color>
    <Color x:Key="ErrorBgColor">#2A1215</Color>
    <Color x:Key="InfoTextColor">#60A5FA</Color>
    <Color x:Key="InfoBgColor">#0F1D33</Color>
    <Color x:Key="NeutralTextColor">#9CA3AF</Color>
    <Color x:Key="ShadowColor">#000000</Color>

    <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#4F46E5" Offset="0.0" />
        <GradientStop Color="#2563EB" Offset="1.0" />
    </LinearGradientBrush>

</ResourceDictionary>
