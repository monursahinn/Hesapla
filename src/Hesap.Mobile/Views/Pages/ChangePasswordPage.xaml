<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage
    x:Class="Hesap.Mobile.Views.Pages.ChangePasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Hesap.Mobile.Views"
    xmlns:vm="clr-namespace:Hesap.Mobile.ViewModels"
    x:DataType="vm:ChangePasswordViewModel"
    Title="Şifre değiştir">

    <ScrollView>
        <VerticalStackLayout Padding="20,24" Spacing="16">
            <VerticalStackLayout Spacing="8">
                <Label Text="Mevcut şifre" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource InputBorder}">
                    <Entry Text="{Binding CurrentPassword}" IsPassword="True" />
                </Border>
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="8">
                <Label Text="Yeni şifre" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource InputBorder}">
                    <Entry Text="{Binding NewPassword}" IsPassword="True" />
                </Border>
                <Label Text="En az 8 karakter; en az bir harf ve bir rakam." Style="{StaticResource MutedLabel}" />
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="8">
                <Label Text="Yeni şifre (tekrar)" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource InputBorder}">
                    <Entry Text="{Binding ConfirmPassword}" IsPassword="True" ReturnType="Done" ReturnCommand="{Binding SaveCommand}" />
                </Border>
            </VerticalStackLayout>

            <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}" IsVisible="{Binding HasError}" />
            <Button Text="Kaydet" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" IsEnabled="{Binding IsNotBusy}" />
        </VerticalStackLayout>
    </ScrollView>
</views:BasePage>
