<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage
    x:Class="Hesap.Mobile.Views.Pages.CustomerDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Hesap.Mobile.Views"
    xmlns:vm="clr-namespace:Hesap.Mobile.ViewModels"
    xmlns:controls="clr-namespace:Hesap.Mobile.Controls"
    xmlns:api="clr-namespace:Hesap.Mobile.Models.Api"
    x:DataType="vm:CustomerDetailViewModel"
    Title="Cari ekstre">

    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}">
        <CollectionView ItemsSource="{Binding Rows}" SelectionMode="None" Margin="16,0">
            <CollectionView.Header>
                <VerticalStackLayout Spacing="12" Padding="0,16,0,8">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding Data.Customer.Title}" Style="{StaticResource PageTitleLabel}" FontSize="20" />
                        <Label Style="{StaticResource SubtitleLabel}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding Data.Customer.Code}" />
                                    <Span Text=" • " />
                                    <Span Text="{Binding Data.Customer.TypeText}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>

                    <Border Style="{StaticResource Card}">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Güncel bakiye" Style="{StaticResource MutedLabel}" />
                                <Label Text="{Binding Data.Customer.AbsBalance, Converter={StaticResource Currency}}" Style="{StaticResource AmountLabel}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding Data.Customer.BalanceText}" Style="{StaticResource SubtitleLabel}" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Text="+ Tahsilat" Style="{StaticResource PrimaryButton}" Command="{Binding CollectCommand}" IsVisible="{Binding CanCollect}" />
                        <Button Grid.Column="1" Text="+ Ödeme" Style="{StaticResource SecondaryButton}" HeightRequest="48" Command="{Binding PayCommand}" IsVisible="{Binding CanPay}" />
                    </Grid>

                    <Label Text="Ekstre" Style="{StaticResource SectionTitleLabel}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Border Style="{StaticResource InputBorder}">
                            <DatePicker Date="{Binding From}" Format="dd.MM.yyyy" />
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource InputBorder}">
                            <DatePicker Date="{Binding To}" Format="dd.MM.yyyy" />
                        </Border>
                    </Grid>
                    <Button Text="Ekstreyi getir" Style="{StaticResource SecondaryButton}" Command="{Binding LoadCommand}" />

                    <Grid ColumnDefinitions="*,*">
                        <VerticalStackLayout>
                            <Label Text="Dönem başı devir" Style="{StaticResource MutedLabel}" />
                            <Label Text="{Binding Data.OpeningBalance, Converter={StaticResource Currency}}" FontFamily="OpenSansSemibold" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="End">
                            <Label Text="Dönem sonu" Style="{StaticResource MutedLabel}" HorizontalOptions="End" />
                            <Label Text="{Binding Data.ClosingBalance, Converter={StaticResource Currency}}" FontFamily="OpenSansSemibold" HorizontalOptions="End" />
                        </VerticalStackLayout>
                    </Grid>
                    <Label Text="Bakiye: artı değer alacağınız, eksi değer borcunuzdur." Style="{StaticResource MutedLabel}" />

                    <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}" IsVisible="{Binding HasError}" />
                    <controls:Skeleton Rows="4" IsVisible="{Binding ShowSkeleton}" />
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.EmptyView>
                <Label Text="Bu dönemde hareket yok." Style="{StaticResource SubtitleLabel}" HorizontalOptions="Center" Margin="0,24" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="api:StatementRow">
                    <Border Style="{StaticResource ListCard}">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10">
                            <Label Text="{Binding KindLabel}" Style="{StaticResource CardTitleLabel}" />
                            <Label Grid.Row="1" Style="{StaticResource MutedLabel}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding Date, Converter={StaticResource DateText}, ConverterParameter=dd.MM.yyyy}" />
                                        <Span Text="  " />
                                        <Span Text="{Binding DocumentNo}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Description}" Style="{StaticResource MutedLabel}"
                                   IsVisible="{Binding Description, Converter={StaticResource HasText}}" />
                            <Label Grid.Column="1" Text="{Binding Amount, Converter={StaticResource Currency}}" FontFamily="OpenSansSemibold" HorizontalOptions="End" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding Balance, Converter={StaticResource Currency}, StringFormat='Bakiye {0}'}"
                                   Style="{StaticResource MutedLabel}" HorizontalOptions="End" />
                        </Grid>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenRowCommand, Source={RelativeSource AncestorType={x:Type vm:CustomerDetailViewModel}}, x:DataType=vm:CustomerDetailViewModel}"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
</views:BasePage>
