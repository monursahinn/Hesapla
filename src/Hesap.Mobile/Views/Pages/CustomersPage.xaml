<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage
    x:Class="Hesap.Mobile.Views.Pages.CustomersPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Hesap.Mobile.Views"
    xmlns:vm="clr-namespace:Hesap.Mobile.ViewModels"
    xmlns:controls="clr-namespace:Hesap.Mobile.Controls"
    xmlns:api="clr-namespace:Hesap.Mobile.Models.Api"
    x:DataType="vm:CustomersViewModel"
    Title="Cariler">

    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}">
        <CollectionView ItemsSource="{Binding Items}" SelectionMode="None" Margin="16,0"
                        RemainingItemsThreshold="5" RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
            <CollectionView.Header>
                <VerticalStackLayout Spacing="10" Padding="0,16,0,8">
                    <Border Style="{StaticResource InputBorder}">
                        <Entry Text="{Binding Search}" Placeholder="Unvan, kod, vergi no veya telefon ara" ReturnType="Search"
                               ReturnCommand="{Binding LoadCommand}" ClearButtonVisibility="WhileEditing" />
                    </Border>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Border Style="{StaticResource InputBorder}">
                            <Picker ItemsSource="{x:Static vm:CustomersViewModel.Types}" SelectedIndex="{Binding SelectedTypeIndex}" ItemDisplayBinding="{Binding Text, x:DataType=api:Option}" />
                        </Border>
                        <Label Grid.Column="1" Text="{Binding Summary}" Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
                    </Grid>
                    <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}" IsVisible="{Binding HasError}" />
                    <controls:Skeleton Rows="5" IsVisible="{Binding ShowSkeleton}" />
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.EmptyView>
                <Label Text="Kayıt bulunamadı. Yeni cariler web panelinden eklenir." Style="{StaticResource SubtitleLabel}" HorizontalOptions="Center" Margin="0,40" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="api:Customer">
                    <Border Style="{StaticResource ListCard}">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10">
                            <Label Text="{Binding Title}" Style="{StaticResource CardTitleLabel}" />
                            <Label Grid.Row="1" Style="{StaticResource MutedLabel}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding Code}" />
                                        <Span Text=" • " />
                                        <Span Text="{Binding TypeText}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label Grid.Column="1" Text="{Binding AbsBalance, Converter={StaticResource Currency}}" FontFamily="OpenSansSemibold" HorizontalOptions="End" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding BalanceText}" Style="{StaticResource MutedLabel}" HorizontalOptions="End" />
                        </Grid>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type vm:CustomersViewModel}}, x:DataType=vm:CustomersViewModel}"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
</views:BasePage>
