<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage
    x:Class="Hesap.Mobile.Views.Pages.InvoiceDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Hesap.Mobile.Views"
    xmlns:vm="clr-namespace:Hesap.Mobile.ViewModels"
    xmlns:controls="clr-namespace:Hesap.Mobile.Controls"
    xmlns:api="clr-namespace:Hesap.Mobile.Models.Api"
    x:DataType="vm:InvoiceDetailViewModel"
    Title="Fatura">

    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="12">
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}" IsVisible="{Binding HasError}" />
                <controls:Skeleton Rows="4" IsVisible="{Binding ShowSkeleton}" />

                <VerticalStackLayout Spacing="12" IsVisible="{Binding Data, Converter={StaticResource NotNull}}">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Title}" Style="{StaticResource PageTitleLabel}" FontSize="19" />
                            <Label Text="{Binding Data.CustomerTitle}" Style="{StaticResource LinkLabel}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenCustomerCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </VerticalStackLayout>
                        <Border Grid.Column="1" Style="{StaticResource Pill}" BackgroundColor="{Binding StatusCode, Converter={StaticResource StatusTint}, ConverterParameter=invoice}">
                            <Label Text="{Binding StatusCode, Converter={StaticResource StatusText}, ConverterParameter=invoice}" FontSize="12"
                                   TextColor="{Binding StatusCode, Converter={StaticResource StatusColor}, ConverterParameter=invoice}" />
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource Card}" Padding="12" BackgroundColor="{DynamicResource CardAltBackgroundColor}" IsVisible="{Binding Data.Cancelled}">
                        <Label Text="{Binding Data.CancelReason, StringFormat='İptal edildi: {0}'}" Style="{StaticResource SubtitleLabel}" />
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Text="PDF / Paylaş" Style="{StaticResource SecondaryButton}" HeightRequest="48" Command="{Binding SharePdfCommand}" />
                        <Button Grid.Column="1" Text="{Binding PaymentButtonText}" Style="{StaticResource PrimaryButton}" Command="{Binding AddPaymentCommand}" IsVisible="{Binding CanAddPayment}" />
                    </Grid>

                    <Border Style="{StaticResource Card}">
                        <Grid ColumnDefinitions="*,*">
                            <VerticalStackLayout>
                                <Label Text="Tarih" Style="{StaticResource MutedLabel}" />
                                <Label Text="{Binding Data.Date, Converter={StaticResource DateText}, ConverterParameter=dd.MM.yyyy}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="Vade" Style="{StaticResource MutedLabel}" />
                                <Label Text="{Binding Data.DueDate, Converter={StaticResource DateText}, ConverterParameter=dd.MM.yyyy}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Label Text="Satırlar" Style="{StaticResource SectionTitleLabel}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Lines}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="api:InvoiceLine">
                                <Border Style="{StaticResource ListCard}">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10">
                                        <Label Text="{Binding Description}" FontFamily="OpenSansSemibold" FontSize="14" />
                                        <Label Grid.Column="1" Text="{Binding Amount, Converter={StaticResource Currency}}" FontFamily="OpenSansSemibold" />
                                        <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding QuantityText}" Style="{StaticResource MutedLabel}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasDiscount}">
                                <Label Text="Toplam iskonto" Style="{StaticResource SubtitleLabel}" />
                                <Label Grid.Column="1" Text="{Binding Data.DiscountTotal, Converter={StaticResource Currency}}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Ara toplam" Style="{StaticResource SubtitleLabel}" />
                                <Label Grid.Column="1" Text="{Binding Data.Subtotal, Converter={StaticResource Currency}}" />
                            </Grid>
                            <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Vats}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="api:VatRow">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="{Binding Rate, StringFormat='KDV %{0:0.##}'}" Style="{StaticResource SubtitleLabel}" />
                                            <Label Grid.Column="1" Text="{Binding Vat, Converter={StaticResource Currency}}" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <BoxView HeightRequest="1" Color="{DynamicResource SeparatorColor}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Genel toplam" FontFamily="OpenSansSemibold" />
                                <Label Grid.Column="1" Text="{Binding Data.Total, Converter={StaticResource Currency}}" FontFamily="OpenSansSemibold" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding Data.Cancelled, Converter={StaticResource Not}}">
                                <Label Text="{Binding PaidLabel}" Style="{StaticResource SubtitleLabel}" />
                                <Label Grid.Column="1" Text="{Binding Data.Paid, Converter={StaticResource Currency}}" TextColor="{DynamicResource SuccessTextColor}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding Data.Cancelled, Converter={StaticResource Not}}">
                                <Label Text="Kalan" FontFamily="OpenSansSemibold" />
                                <Label Grid.Column="1" Text="{Binding Data.Remaining, Converter={StaticResource Currency}}" FontFamily="OpenSansSemibold" TextColor="{DynamicResource ErrorTextColor}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding Data.IsSettled}" Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource SuccessTextColor}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="{Binding PaymentsTitle}" Style="{StaticResource SectionTitleLabel}" />
                    <Label Text="Henüz bağlı kayıt yok." Style="{StaticResource SubtitleLabel}"
                           IsVisible="{Binding Payments.Count, Converter={StaticResource IntToBool}, ConverterParameter=invert}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Payments}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="api:Movement">
                                <Border Style="{StaticResource ListCard}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout>
                                            <Label Text="{Binding AccountName}" FontSize="14" />
                                            <Label Text="{Binding DateLine}" Style="{StaticResource MutedLabel}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Text="{Binding Amount, Converter={StaticResource Currency}}" FontFamily="OpenSansSemibold" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</views:BasePage>
